#ifndef _CUDA_FPTOOL_MATH
#define _CUDA_FPTOOL_MATH

#include <cuda/std/detail/__config>

#if defined(_CCCL_IMPLICIT_SYSTEM_HEADER_GCC)
#  pragma GCC system_header
#elif defined(_CCCL_IMPLICIT_SYSTEM_HEADER_CLANG)
#  pragma clang system_header
#elif defined(_CCCL_IMPLICIT_SYSTEM_HEADER_MSVC)
#  pragma system_header
#endif // no system header

// Math functions for the analysis types of <cuda/fptool> (exp, log, pow, sin, cos, ...).
//
// This pulls in the core <cuda/fptool> umbrella as well, so including
// <cuda/fptool_math> alone is sufficient to get the full fptool API. Translation units
// that do not need math functions should include <cuda/fptool> instead to avoid the
// additional compile-time cost of the fpmp math header underneath.
//
// fp_custom needs no counterpart here: its math functions come from the standard
// spellings on `double` and live in <cuda/__fp/fptool_custom.h> itself.
#include <cuda/__fp/fptool_custom.h>
#include <cuda/__fp/fptool_stat.h>
#include <cuda/__fp/fptool_stat_math.h>

#endif // _CUDA_FPTOOL_MATH
