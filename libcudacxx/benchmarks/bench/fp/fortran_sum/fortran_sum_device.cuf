! ============================================================================
!  FPMP CUDA Fortran Benchmark — Accuracy Sum (device)
!
!  Purpose
!  -------
!  Compares ACCURACY and THROUGHPUT of GPU recursive summation across four
!  accumulator types over a shared single-precision input array:
!
!    Accumulator           Hardware lane     Notes
!    -------------------   ---------------   --------------------------------
!    real(real32)           FP32             native single
!    real(real64)           FP64             native double
!    type(fp32mp2)          FP32 (×2)        float-float; ~46-bit mantissa
!    type(fp64mp2)          FP64 (×2)        double-double; ~106-bit mantissa
!
!  Each kernel runs a two-level reduction:
!    Stage 1: every thread accumulates a strided slice into a register
!             accumulator of its native type, then a shared-memory tree
!             reduction inside each block produces one block partial.
!    Stage 2: the partial is converted to fp64 and written to a per-block
!             global array; the host driver sums the (small) array of block
!             partials in fp64.  The final-stage error from this fp64 sum is
!             negligible relative to the kernel-internal accumulation error
!             being measured.
!
!  Why fp32mp2 is interesting on consumer GPUs
!  -------------------------------------------
!  Most consumer / RTX-class GPUs have FP64 throughput of 1/32 of FP32.
!  fp32mp2 uses ~10-12 FP32 ops per add/mul, so it is ~3x faster than
!  native fp64 while keeping ~46-bit mantissa accuracy — visibly tighter
!  than fp32.  This benchmark exercises that trade-off.
!
!  Workload
!  --------
!  Inputs `x(i)` are deterministic pseudo-random fp32 values in
!  [0, 2^SCALE_BITS), generated by taking the fractional part of `i * φ`
!  (golden-ratio low-discrepancy sequence) and scaling.  Each input has the
!  full 23 bits of fp32 mantissa populated, so summing N of them exposes
!  rounding behaviour at every accumulator's precision boundary — not just
!  fp32 magnitude saturation.
!
!  Reference
!  ---------
!  The reference sum is the result of the fp64mp2 kernel (~106-bit
!  mantissa).  Each other kernel's error is reported relative to this
!  value; the fp64mp2 row therefore reports zero error by construction.
!
!  Per-launch timing: each timed cudaEvent window covers a batch of
!  back-to-back launches of the same kernel so even a sub-millisecond
!  kernel produces a measurement well above timer noise.  The reported
!  time is `elapsed / launches` per launch, and the throughput is
!  computed from that per-launch time.
!
!  Auto-tuning: by default (KERNEL_LAUNCHES=0) the number of launches
!  per timed window is chosen PER KERNEL so each batch runs for at least
!  MIN_BATCH_MS milliseconds.  This is what you want for reliable
!  performance numbers — fast kernels (e.g. native fp32 over 10⁷ inputs
!  is ~15 µs) get thousands of launches per window, slow ones (fp64mp2
!  ~250 µs) get only a few hundred.  Set KERNEL_LAUNCHES to a positive
!  value to disable auto-tuning and use a fixed batch count.
!
!  Compile-time controls (override on the make command line):
!      -DN_ELEMENTS=<int>      default: 10000000
!      -DN_REPS=<int>          default: 5
!      -DSCALE_BITS=<int>      default: 0  (max input ≈ 2^0)
!      -DBLOCK_SIZE=<int>      default: 256
!      -DNUM_BLOCKS=<int>      default: 1024
!      -DMIN_BATCH_MS=<int>    default: 100 (≥ 0.1 s per timed window)
!      -DKERNEL_LAUNCHES=<int> default: 0   (0 = auto-tune to MIN_BATCH_MS;
!                                            >0 = fixed override)
!      -DMAX_KERNEL_LAUNCHES=<int> default: 1000000 (auto-tune safety cap)
!      -DCALIB_LAUNCHES=<int>  default: 32  (warm-up + calibration batch
!                                            size; raise for more stable
!                                            auto-tune at the cost of
!                                            slightly longer startup)
! ============================================================================

#ifndef N_ELEMENTS
#define N_ELEMENTS 10000000
#endif

#ifndef N_REPS
#define N_REPS 5
#endif

#ifndef SCALE_BITS
#define SCALE_BITS 0
#endif

#ifndef BLOCK_SIZE
#define BLOCK_SIZE 256
#endif

#ifndef NUM_BLOCKS
#define NUM_BLOCKS 1024
#endif

#ifndef MIN_BATCH_MS
#define MIN_BATCH_MS 100
#endif

#ifndef KERNEL_LAUNCHES
#define KERNEL_LAUNCHES 0
#endif

#ifndef MAX_KERNEL_LAUNCHES
#define MAX_KERNEL_LAUNCHES 1000000
#endif

#ifndef CALIB_LAUNCHES
#define CALIB_LAUNCHES 32
#endif

! ----------------------------------------------------------------------------
!  Reduction kernels — one per accumulator type.  All four read from the
!  same fp32 input array; the per-kernel native cast/conversion happens
!  in the inner loop.
! ----------------------------------------------------------------------------
module fortran_sum_kernels
  use, intrinsic :: iso_fortran_env
  use fpmp_api
  use cudafor
  implicit none

  integer, parameter :: BLK = BLOCK_SIZE

contains

  attributes(global) subroutine reduce_fp32(x, partial, n)
    real(real32), device, intent(in)  :: x(*)
    real(real64), device, intent(out) :: partial(*)
    integer,      value               :: n

    real(real32), shared :: sdata(BLK)
    integer      :: tid, gid, stride, i
    real(real32) :: acc

    tid    = threadIdx%x
    gid    = (blockIdx%x - 1) * blockDim%x + tid
    stride = blockDim%x * gridDim%x

    acc = 0.0_real32
    i   = gid
    do while (i <= n)
      acc = acc + x(i)
      i   = i + stride
    end do
    sdata(tid) = acc
    call syncthreads()

    stride = blockDim%x / 2
    do while (stride > 0)
      if (tid <= stride) sdata(tid) = sdata(tid) + sdata(tid + stride)
      call syncthreads()
      stride = stride / 2
    end do

    if (tid == 1) partial(blockIdx%x) = real(sdata(1), real64)
  end subroutine reduce_fp32

  attributes(global) subroutine reduce_fp64(x, partial, n)
    real(real32), device, intent(in)  :: x(*)
    real(real64), device, intent(out) :: partial(*)
    integer,      value               :: n

    real(real64), shared :: sdata(BLK)
    integer      :: tid, gid, stride, i
    real(real64) :: acc

    tid    = threadIdx%x
    gid    = (blockIdx%x - 1) * blockDim%x + tid
    stride = blockDim%x * gridDim%x

    acc = 0.0_real64
    i   = gid
    do while (i <= n)
      acc = acc + real(x(i), real64)
      i   = i + stride
    end do
    sdata(tid) = acc
    call syncthreads()

    stride = blockDim%x / 2
    do while (stride > 0)
      if (tid <= stride) sdata(tid) = sdata(tid) + sdata(tid + stride)
      call syncthreads()
      stride = stride / 2
    end do

    if (tid == 1) partial(blockIdx%x) = sdata(1)
  end subroutine reduce_fp64

  attributes(global) subroutine reduce_fp32mp2(x, partial, n)
    real(real32), device, intent(in)  :: x(*)
    real(real64), device, intent(out) :: partial(*)
    integer,      value               :: n

    type(fp32mp2), shared :: sdata(BLK)
    integer       :: tid, gid, stride, i
    type(fp32mp2) :: acc

    tid    = threadIdx%x
    gid    = (blockIdx%x - 1) * blockDim%x + tid
    stride = blockDim%x * gridDim%x

    acc = 0.0_c_float                               ! defined assignment(=)
    i   = gid
    do while (i <= n)
      acc = acc + x(i)                              ! mixed-type operator(+)
      i   = i + stride
    end do
    sdata(tid) = acc
    call syncthreads()

    stride = blockDim%x / 2
    do while (stride > 0)
      if (tid <= stride) sdata(tid) = sdata(tid) + sdata(tid + stride)
      call syncthreads()
      stride = stride / 2
    end do

    if (tid == 1) partial(blockIdx%x) = fpmp_to_double(sdata(1))
  end subroutine reduce_fp32mp2

  attributes(global) subroutine reduce_fp64mp2(x, partial, n)
    real(real32), device, intent(in)  :: x(*)
    real(real64), device, intent(out) :: partial(*)
    integer,      value               :: n

    type(fp64mp2), shared :: sdata(BLK)
    integer       :: tid, gid, stride, i
    type(fp64mp2) :: acc

    tid    = threadIdx%x
    gid    = (blockIdx%x - 1) * blockDim%x + tid
    stride = blockDim%x * gridDim%x

    acc = 0.0_c_float                               ! defined assignment(=)
    i   = gid
    do while (i <= n)
      acc = acc + x(i)                              ! mixed-type operator(+)
      i   = i + stride
    end do
    sdata(tid) = acc
    call syncthreads()

    stride = blockDim%x / 2
    do while (stride > 0)
      if (tid <= stride) sdata(tid) = sdata(tid) + sdata(tid + stride)
      call syncthreads()
      stride = stride / 2
    end do

    if (tid == 1) partial(blockIdx%x) = fpmp_to_double(sdata(1))
  end subroutine reduce_fp64mp2

end module fortran_sum_kernels


! ----------------------------------------------------------------------------
!  Host driver: launch each kernel REPS times, time with cudaEvents,
!               finalise on host in fp64, report accuracy + throughput.
! ----------------------------------------------------------------------------
program fortran_sum_device
  use, intrinsic :: iso_fortran_env
  use fortran_sum_kernels
  use cudafor
  implicit none

  integer, parameter :: N        = N_ELEMENTS
  integer, parameter :: REPS     = N_REPS
  integer, parameter :: NB       = NUM_BLOCKS
  integer, parameter :: KL_FIXED = KERNEL_LAUNCHES         ! 0 = auto
  integer, parameter :: KL_MAX   = MAX_KERNEL_LAUNCHES
  integer, parameter :: KL_CALIB = CALIB_LAUNCHES          ! warm-up + calibration batch
  real(real64), parameter :: TARGET_BATCH_S = real(MIN_BATCH_MS, real64) * 1.0e-3_real64

  ! Golden-ratio low-discrepancy sequence multiplier (φ - 1).
  real(real64), parameter :: PHI   = 0.6180339887498948_real64
  real(real64), parameter :: SCALE = 2.0_real64**SCALE_BITS

  real(real32), allocatable          :: x_h(:)
  real(real64)                       :: partial_h(NB)
  real(real32), device, allocatable  :: x_d(:)
  real(real64), device, allocatable  :: partial_d(:)

  real(real64)    :: ref_sum, u
  integer         :: istat, i, b

  type(cudaEvent) :: evt_start, evt_stop
  real            :: elapsed_ms
  real(real64)    :: dt_min

  ! Per-accumulator results, indexed by `kind + 1`
  ! (1 = fp32, 2 = fp64, 3 = fp32mp2, 4 = fp64mp2).  run_one() fills these
  ! and the table is printed in one pass at the end; that lets every row
  ! reference dt_arr(2) (the real64 row) for the "Speedup vs real64"
  ! column without forcing the real64 kernel to run first.
  real(real64)    :: got_arr(4), dt_arr(4)
  integer         :: kl_arr(4)

  ! Generate the input array on the host (deterministic LDS in [0, scale)),
  ! then transfer once to the device.
  allocate(x_h(N), x_d(N), partial_d(NB))
  do i = 1, N
    u      = modulo(real(i, real64) * PHI, 1.0_real64)
    x_h(i) = real(u * SCALE, real32)
  end do
  x_d = x_h

  istat = cudaEventCreate(evt_start)
  istat = cudaEventCreate(evt_stop)

  ! Run fp64mp2 once to establish the reference sum (~106-bit mantissa).
  call reduce_fp64mp2<<<NB, BLOCK_SIZE>>>(x_d, partial_d, N)
  istat = cudaDeviceSynchronize()
  partial_h = partial_d
  ref_sum   = 0.0_real64
  do b = 1, NB
    ref_sum = ref_sum + partial_h(b)
  end do

  print '(A)',         '======================================================================================'
  print '(A)',         '  FPMP CUDA Fortran Benchmark — Accuracy Sum (device)'
  print '(A)',         '======================================================================================'
  print '(A,I0)',      '  N            = ', N
  print '(A,I0)',      '  blocks       = ', NB
  print '(A,I0)',      '  threads/blk  = ', BLOCK_SIZE
  print '(A,I0)',      '  repetitions  = ', REPS
  if (KL_FIXED > 0) then
    print '(A,I0,A)',  '  launches/rep = ', KL_FIXED, ' (fixed; per-launch time = elapsed / launches)'
  else
    print '(A,I0,A)',  '  launches/rep = auto-tune to ≥ ', MIN_BATCH_MS, &
                       ' ms per timed window (per-kernel)'
  end if
  print '(A,I0,A,ES10.3)', '  scale        = 2^', SCALE_BITS, ' = ', SCALE
  print '(A)',         '  inputs       = pseudo-random fp32 in [0, scale) (golden-ratio LDS)'
  print '(A)',         '  reference    = fp64mp2 reduction (~106-bit mantissa)'
  print '(A,ES22.15)', '  reference    = ', ref_sum
  print '(A)',         '--------------------------------------------------------------------------------------'
  print '(A)',         '  Accumulator       |Error|     Rel.Err  Throughput        Time     Speedup  Launches'
  print '(A)',         '                                         (Melem/s)         (s)   vs real64'
  print '(A)',         '  -------------  ----------  ----------  ----------  ----------  ----------  --------'

  call run_one('real(real32) ', 0)
  call run_one('real(real64) ', 1)
  call run_one('type(fp32mp2)', 2)
  call run_one('type(fp64mp2)', 3)

  call print_table()

  istat = cudaEventDestroy(evt_start)
  istat = cudaEventDestroy(evt_stop)

  print '(A)', '======================================================================================'

  deallocate(x_h, x_d, partial_d)

contains

  ! Launch the chosen kernel REPS times, keep the fastest per-launch
  ! timing, finalise on host in fp64, and report.  Each timed window
  ! covers `kl` back-to-back launches so sub-millisecond kernels still
  ! produce a clean measurement.
  !
  ! `kl` is auto-tuned per kernel by default (KERNEL_LAUNCHES=0): a
  ! `CALIB_LAUNCHES`-launch warm-up settles caches / JIT / kernel resident
  ! state, then a `CALIB_LAUNCHES`-launch calibration batch is timed and
  ! divided through to get a steady-state per-launch baseline.  A single
  ! warm-up + single calibration launch is *not* enough on the FPMP rows
  ! at this geometry: even after one warm-up the FPMP kernels still
  ! report ~2x the steady-state per-launch time on the first measured
  ! launch, which made the auto-tuner pick `kl` low enough that the
  ! resulting batches ran for only ~45 ms (well below the 100 ms target).
  ! A 32-launch calibration brings the baseline within a few percent of
  ! steady-state, and every per-kernel batch lands at the requested
  ! MIN_BATCH_MS target.
  !
  ! With the baseline in hand, `kl = ceil(MIN_BATCH_MS / baseline_s)`,
  ! clamped to [1, MAX_KERNEL_LAUNCHES], so each timed window runs for
  ! at least MIN_BATCH_MS milliseconds.  Setting KERNEL_LAUNCHES to a
  ! positive value disables auto-tuning and uses that fixed batch count
  ! for every kernel.
  subroutine run_one(label, kind)
    ! `label` is unused inside this routine (the table printer owns the
    ! row labels now), but is retained as a dummy argument so the call
    ! sites in the main program stay self-documenting:
    !     call run_one('real(real32) ', 0)
    !     call run_one('real(real64) ', 1)
    !     ...
    character(len=*), intent(in) :: label
    integer,          intent(in) :: kind   ! 0=r32, 1=r64, 2=fp32mp2, 3=fp64mp2

    integer      :: rep, j, b, kl
    real(real64) :: total, dt_per_launch, baseline_s

    ! ---- 1. Pick the per-window launch count ----
    if (KL_FIXED > 0) then
      kl = KL_FIXED
    else
      ! Warm-up: a batch of KL_CALIB launches.  A single warm-up launch
      ! is not enough on the FPMP rows -- their first-after-warmup
      ! launch still measures ~2x steady-state on this hardware, which
      ! tricks the auto-tuner into a too-small `kl`.
      do j = 1, KL_CALIB
        call dispatch_kernel(kind)
      end do
      istat = cudaDeviceSynchronize()

      ! Multi-launch calibration: KL_CALIB back-to-back launches, with
      ! `baseline_s = elapsed / KL_CALIB`.  Averages out timer noise
      ! and first-launch transients, yielding a baseline within a few
      ! percent of steady-state for every kernel.
      istat = cudaEventRecord(evt_start, 0)
      do j = 1, KL_CALIB
        call dispatch_kernel(kind)
      end do
      istat = cudaEventRecord(evt_stop, 0)
      istat = cudaEventSynchronize(evt_stop)
      istat = cudaEventElapsedTime(elapsed_ms, evt_start, evt_stop)

      baseline_s = max(real(elapsed_ms, real64) * 1.0e-3_real64 / real(KL_CALIB, real64), &
                       1.0e-9_real64)
      kl         = int(ceiling(TARGET_BATCH_S / baseline_s))
      kl         = max(1, min(KL_MAX, kl))
    end if

    ! ---- 2. Time `REPS` windows, each batching `kl` launches ----
    dt_min = huge(dt_min)
    do rep = 1, REPS
      istat = cudaEventRecord(evt_start, 0)
      do j = 1, kl
        call dispatch_kernel(kind)
      end do
      istat = cudaEventRecord(evt_stop, 0)
      istat = cudaEventSynchronize(evt_stop)
      istat = cudaEventElapsedTime(elapsed_ms, evt_start, evt_stop)
      dt_per_launch = real(elapsed_ms, real64) * 1.0e-3_real64 / real(kl, real64)
      dt_min = min(dt_min, dt_per_launch)
    end do

    ! ---- 3. Read back partials and sum on host ----
    partial_h = partial_d
    total = 0.0_real64
    do b = 1, NB
      total = total + partial_h(b)
    end do

    got_arr(kind + 1) = total
    dt_arr(kind + 1)  = dt_min
    kl_arr(kind + 1)  = kl
  end subroutine run_one

  ! Dispatch one kernel launch of the chosen accumulator type.  Pulled
  ! into its own routine so calibration and timing share the exact same
  ! launch path.
  subroutine dispatch_kernel(kind)
    integer, intent(in) :: kind
    select case (kind)
    case (0)
      call reduce_fp32   <<<NB, BLOCK_SIZE>>>(x_d, partial_d, N)
    case (1)
      call reduce_fp64   <<<NB, BLOCK_SIZE>>>(x_d, partial_d, N)
    case (2)
      call reduce_fp32mp2<<<NB, BLOCK_SIZE>>>(x_d, partial_d, N)
    case (3)
      call reduce_fp64mp2<<<NB, BLOCK_SIZE>>>(x_d, partial_d, N)
    end select
  end subroutine dispatch_kernel

  ! Print all four rows in one pass.  Splitting print from time
  ! collection lets every row reference dt_arr(2) (the real64 row) for
  ! the "Speedup vs real64" column even though run_one() for the real32
  ! kernel completes first.
  subroutine print_table()
    call print_row('real(real32) ', got_arr(1), dt_arr(1), kl_arr(1))
    call print_row('real(real64) ', got_arr(2), dt_arr(2), kl_arr(2))
    call print_row('type(fp32mp2)', got_arr(3), dt_arr(3), kl_arr(3))
    call print_row('type(fp64mp2)', got_arr(4), dt_arr(4), kl_arr(4))
  end subroutine print_table

  ! Numeric columns are uniform ES10.3 with two-space gutters so every
  ! header / data byte lands on a fixed column boundary.  Units
  ! (Melem/s, s, "vs real64") live in the header sub-line.  Speedup
  ! uses F10.3 so the typical O(0.1)..O(10) ratios read cleanly without
  ! exponent noise.  `kl` (per-window launch count) goes in a dedicated
  ! I8 `Launches` column at the right of the row.
  subroutine print_row(label, got, dt, kl)
    character(len=*), intent(in) :: label
    real(real64),     intent(in) :: got, dt
    integer,          intent(in) :: kl
    real(real64) :: err, rel, melem_per_s, speedup
    err         = abs(got - ref_sum)
    rel         = err / max(abs(ref_sum), 1.0e-300_real64)
    melem_per_s = real(N, real64) / max(dt, 1.0e-12_real64) * 1.0e-6_real64
    speedup     = dt_arr(2) / max(dt, 1.0e-12_real64)
    print '(2X,A,2X,ES10.3,2X,ES10.3,2X,ES10.3,2X,ES10.3,2X,F10.3,2X,I8)', &
      label, err, rel, melem_per_s, dt, speedup, kl
  end subroutine print_row

end program fortran_sum_device
